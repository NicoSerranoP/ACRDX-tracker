{
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2023",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "types": ["node"],
    "resolveJsonModule": true
  }
}
